# ---------- Base de donnees ----------
DATABASE_URL="postgresql://hydroalert:hydroalert@127.0.0.1:5432/hydroalert?schema=public"
# Base dediee aux tests d'integration (pnpm test:integration). Elle est migree et remplie de donnees fictives.
TEST_DATABASE_URL="postgresql://hydroalert:hydroalert@127.0.0.1:5432/hydroalert_test?schema=public"

# ---------- Serveur API ----------
# development | test | production
NODE_ENV=development
PORT=3000
# 0.0.0.0 rend l'API joignable depuis les autres appareils du reseau (telephone, PC des coequipiers).
HOST=0.0.0.0

# Adresse a laquelle les clients joignent l'API. Utilisee par Swagger (/docs) et par pnpm docs:api.
# Exemples :
#   machine locale uniquement : http://127.0.0.1:3000
#   meme Wi-Fi               : http://192.168.1.25:3000   (IP locale du PC, voir ipconfig)
#   hebergement en ligne     : https://hydroalert-api.example.org
API_PUBLIC_URL=http://127.0.0.1:3000

# Origines web autorisees a appeler l'API depuis un navigateur (CORS), separees par des virgules.
# "*" autorise toutes les origines : acceptable en developpement, interdit par defaut en production.
# Exemple : CORS_ORIGINS=http://localhost:5173,https://hydroalert-web.example.org
CORS_ORIGINS=*
